{
  "name": "even-speed-meter",
  "version": "0.11.0",
  "private": true,
  "description": "Even G2 GPS speedometer (km/h) using the phone's geolocation",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5273 --strictPort",
    "dev:https": "cross-env VITE_HTTPS=1 vite --host 0.0.0.0 --port 5273 --strictPort",
    "sim": "concurrently -k -n vite,sim -c blue,magenta \"npm:_serve\" \"npm:_sim\"",
    "_sim": "node scripts/sim.mjs",
    "start": "concurrently -k -n server,qr -c blue,green \"npm:_serve\" \"npm:_qr\"",
    "start:https": "cross-env VITE_HTTPS=1 concurrently -k -n server,qr -c blue,green \"npm:_serve\" \"npm:_qr:https\"",
    "_serve": "vite --host 0.0.0.0 --port 5273 --strictPort",
    "_qr": "node scripts/qr.mjs",
    "_qr:https": "cross-env USE_HTTPS=1 node scripts/qr.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o speed-meter.ehpk",
    "deploy:surge": "npm run build && surge dist speed-meter-g2.surge.sh",
    "qr:surge": "node scripts/qr.mjs --url https://speed-meter-g2.surge.sh/",
    "deploy:pages": "npm run build && gh-pages -d dist",
    "qr:pages": "node scripts/qr.mjs --url https://a2spxs.github.io/speed-meter/"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "latest",
    "@evenrealities/evenhub-simulator": "^0.4.1",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "gh-pages": "^6.3.0",
    "qrcode": "^1.5.4",
    "surge": "^0.27.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
